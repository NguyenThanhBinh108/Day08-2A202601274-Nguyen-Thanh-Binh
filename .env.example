# =============================================================================
# LLM PROVIDER POOL — xoay vòng nhiều nhà cung cấp để không bị chặn bởi rate limit
# =============================================================================
# Hệ thống thử lần lượt theo thứ tự ưu tiên bên dưới; dòng nào bỏ trống thì tự
# động bỏ qua. Càng nhiều nhà cung cấp càng ít gián đoạn, vì hạn mức của các bên
# là ĐỘC LẬP nhau — Groq hết lượt thì Cerebras vẫn còn.
#
# Cả nhóm muốn góp key của CÙNG một bên thì ngăn bằng dấu phẩy:
#     GROQ_API_KEY=gsk_key_binh,gsk_key_dang,gsk_key_vu
# Mỗi key phải là tài khoản thật của một thành viên. KHÔNG tự lập nhiều tài khoản
# ảo để né hạn mức — việc đó vi phạm điều khoản dịch vụ của nhà cung cấp.
#
# Kiểm tra pool nhận được những gì:  python -m src.llm_pool

# --- Ưu tiên 1: Groq (nhanh nhất, hạn mức free rộng nhất) -------------------
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Ưu tiên 2: Cerebras (rất nhanh) ----------------------------------------
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# --- Ưu tiên 3: Google Gemini -----------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Ưu tiên 4: GitHub Models (miễn phí cho tài khoản GitHub) ---------------
# Personal Access Token: https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=

# --- Ưu tiên 5: Mistral -----------------------------------------------------
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# --- Ưu tiên 6: OpenRouter (có model :free, nhưng dễ cạn credit) ------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# --- Ưu tiên 7: OpenAI (trả phí) --------------------------------------------
# OPENAI_API_KEY=sk-proj-...


# =============================================================================
# TUỲ CHỌN KHÁC
# =============================================================================

# PageIndex API Key (Task 8). Không có key thì Task 8 tự chạy chế độ vectorless
# cục bộ: duyệt cây mục lục markdown thay vì gọi API.
# PAGEINDEX_API_KEY=pix_...

# Jina API Key (Task 7) — cross-encoder rerank đa ngôn ngữ qua API.
# JINA_API_KEY=jina_...

# EMBEDDING_PROVIDER=sentence_transformers  # Mặc định (local, nặng ~1-2GB do kéo theo torch)
# EMBEDDING_PROVIDER=google                 # Nhẹ, cần GEMINI_API_KEY, dimension 768
# EMBEDDING_PROVIDER=openai                 # Nhẹ, cần OPENAI_API_KEY, dimension 1536
# Lưu ý: đổi provider phải xoá chroma_db/ cũ và chạy lại Task 4 (dimension khác
# nhau, không tương thích ngược)
